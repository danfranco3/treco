# Required — generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me-to-a-random-32-byte-hex-string

# Database — SQLite default (no setup needed), Postgres for production
DATABASE_URL=sqlite+aiosqlite:///./treco.db
DATABASE_MODE=sqlite

# LLM — required for "treco refine" (AI-proposed criteria + test commands)
ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
# LLM_PROVIDER=openai
